# Copy this file to .env and fill in real values before running.

# MongoDB connection string — local instance or MongoDB Atlas
MONGODB_URI=mongodb://127.0.0.1:27017/nxco

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret

# How long a login token stays valid
JWT_EXPIRES_IN=30d

# Port the API listens on
PORT=4000

# Shown as the header on generated order invoices (PDF)
COMPANY_NAME=NXCO

# Comma-separated list of origins allowed to call this API (web admin, Expo dev, etc.)
CORS_ORIGINS=*
